# CHRONO_DISABLE_DOTENV is a process-only switch; launchers may set it before import.
CHRONO_RUNTIME_PROFILE=local
CHRONO_DEBUG=true
CHRONO_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
CHRONO_TRUSTED_HOSTS=["127.0.0.1","localhost"]
# Optional SQLAlchemy URL. When non-empty, this takes priority over CHRONO_SQLITE_PATH.
# PostgreSQL defaults to the psycopg 3 driver. Keep credentials outside Git.
# Production requires PostgreSQL with sslmode=verify-full.
# CHRONO_DATABASE_URL=postgresql+psycopg://user:password@db.example.test:5432/chronovita?sslmode=verify-full
# CHRONO_SQLITE_PATH=data/chronovita.db
# apply-safe is for local/offline startup; validate rejects pending migrations.
CHRONO_DATABASE_MIGRATION_MODE=apply-safe
CHRONO_DATABASE_POOL_SIZE=5
CHRONO_DATABASE_MAX_OVERFLOW=10
CHRONO_DATABASE_POOL_TIMEOUT_SECONDS=30
CHRONO_DATABASE_POOL_RECYCLE_SECONDS=1800
CHRONO_DATABASE_CONNECT_TIMEOUT_SECONDS=10
CHRONO_CONTENT_ROOT=content
CHRONO_GAME_CATALOG_PATH=scenarios/catalog.v1.json
CHRONO_GAME_USER_ID=local-student
# Required for manual startup. The one-click launcher generates a random value.
CHRONO_ADMIN_TOKEN=
CHRONO_ADMIN_ACTOR=local-admin
# legacy-local keeps the loopback one-click editor; accounts enables real users.
CHRONO_AUTH_MODE=legacy-local
CHRONO_AUTH_SESSION_TTL_SECONDS=28800
CHRONO_AUTH_COOKIE_NAME=chronovita_session
CHRONO_AUTH_COOKIE_SECURE=false
# Process-local token bucket for POST /api/v1/auth/login.
CHRONO_AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=10
CHRONO_AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CHRONO_AUTH_LOGIN_RATE_LIMIT_MAX_CLIENTS=10000
# Required only for the first startup of an empty database in accounts mode.
CHRONO_AUTH_BOOTSTRAP_USERNAME=
CHRONO_AUTH_BOOTSTRAP_PASSWORD=
CHRONO_AUTH_BOOTSTRAP_DISPLAY_NAME=Chronovita Admin

# LLM 适配层
# provider 可选：mock / deepseek
CHRONO_LLM_PROVIDER=mock
CHRONO_DEEPSEEK_API_KEY=
CHRONO_DEEPSEEK_BASE_URL=https://api.deepseek.com
CHRONO_DEEPSEEK_MODEL=deepseek-v4-flash
CHRONO_DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# thinking 可选：disabled（默认，速度快）/ enabled（带推理，慢）
CHRONO_DEEPSEEK_THINKING=disabled
# AI-001 结构化分类/叙事边界；超时后由业务层执行确定性回退
CHRONO_LLM_STRUCTURED_TIMEOUT_SECONDS=12
CHRONO_LLM_STRUCTURED_MAX_TOKENS=512
CHRONO_LLM_STRUCTURED_MAX_RESPONSE_BYTES=32768
