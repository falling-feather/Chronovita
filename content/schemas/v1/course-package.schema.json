{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronovita.local/schemas/v1/course-package.schema.json",
  "$comment": "Lifecycle conditions are represented here when JSON Schema can express them. Cross-object references, checksums and replay invariants require the services.contracts RuntimeBundleV1 semantic validator.",
  "$defs": {
    "CompatibilitySourceV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "native-v1",
          "enum": [
            "native-v1",
            "lesson-content-package",
            "saga-template",
            "sandbox-scenario"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "default": "",
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "default": "",
          "title": "Source Version",
          "type": "string"
        },
        "source_checksum": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Checksum"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "unresolved_refs": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Refs",
          "type": "array"
        },
        "legacy_materials": {
          "items": {
            "$ref": "#/$defs/LegacyMaterialSnapshotV1"
          },
          "title": "Legacy Materials",
          "type": "array"
        },
        "legacy_id_map": {
          "additionalProperties": {
            "maxLength": 64,
            "minLength": 2,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
            "type": "string"
          },
          "title": "Legacy Id Map",
          "type": "object"
        }
      },
      "title": "CompatibilitySourceV1",
      "type": "object"
    },
    "FactV1": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Fact Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "source_ref_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 2,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
            "type": "string"
          },
          "title": "Source Ref Ids",
          "type": "array"
        },
        "certainty": {
          "default": "consensus",
          "enum": [
            "consensus",
            "interpretation",
            "legend",
            "disputed"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "teacher_note": {
          "default": "",
          "title": "Teacher Note",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "statement"
      ],
      "title": "FactV1",
      "type": "object"
    },
    "KeywordV1": {
      "additionalProperties": false,
      "properties": {
        "keyword_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Keyword Id",
          "type": "string"
        },
        "word": {
          "minLength": 1,
          "title": "Word",
          "type": "string"
        },
        "pinyin": {
          "default": "",
          "title": "Pinyin",
          "type": "string"
        },
        "gloss": {
          "default": "",
          "title": "Gloss",
          "type": "string"
        },
        "source_ref_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 2,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
            "type": "string"
          },
          "title": "Source Ref Ids",
          "type": "array"
        }
      },
      "required": [
        "keyword_id",
        "word"
      ],
      "title": "KeywordV1",
      "type": "object"
    },
    "LegacyMaterialSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "saga",
            "sandbox"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "objective": {
          "default": "",
          "title": "Objective",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "assets": {
          "items": {
            "type": "string"
          },
          "title": "Assets",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LegacyMaterialSnapshotV1",
      "type": "object"
    },
    "MapPointV1": {
      "additionalProperties": false,
      "properties": {
        "point_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Point Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "region": {
          "default": "",
          "title": "Region",
          "type": "string"
        },
        "lat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lng": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lng"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "kind": {
          "default": "site",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "point_id",
        "label"
      ],
      "title": "MapPointV1",
      "type": "object"
    },
    "PersonV1": {
      "additionalProperties": false,
      "properties": {
        "person_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Person Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "role": {
          "default": "",
          "title": "Role",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "persona": {
          "default": "",
          "title": "Persona",
          "type": "string"
        },
        "boundaries": {
          "items": {
            "type": "string"
          },
          "title": "Boundaries",
          "type": "array"
        },
        "fact_refs": {
          "items": {
            "maxLength": 64,
            "minLength": 2,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
            "type": "string"
          },
          "title": "Fact Refs",
          "type": "array"
        },
        "source_ref_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 2,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
            "type": "string"
          },
          "title": "Source Ref Ids",
          "type": "array"
        }
      },
      "required": [
        "person_id",
        "name"
      ],
      "title": "PersonV1",
      "type": "object"
    },
    "ScenarioRefV1": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_version": {
          "minimum": 0,
          "title": "Scenario Version",
          "type": "integer"
        },
        "checksum": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "primary": {
          "default": false,
          "title": "Primary",
          "type": "boolean"
        }
      },
      "required": [
        "scenario_id",
        "scenario_version"
      ],
      "title": "ScenarioRefV1",
      "type": "object"
    },
    "SeedCanvasNodeV1": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Node Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "label"
      ],
      "title": "SeedCanvasNodeV1",
      "type": "object"
    },
    "SourceRefV1": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "kind": {
          "default": "other",
          "enum": [
            "curriculum",
            "textbook",
            "primary_source",
            "research",
            "museum",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "publisher": {
          "default": "",
          "title": "Publisher",
          "type": "string"
        },
        "url_or_path": {
          "default": "",
          "title": "Url Or Path",
          "type": "string"
        },
        "citation_note": {
          "default": "",
          "title": "Citation Note",
          "type": "string"
        },
        "reliability": {
          "default": "pending",
          "enum": [
            "pending",
            "reviewed",
            "disputed"
          ],
          "title": "Reliability",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "title"
      ],
      "title": "SourceRefV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "course-package/v1",
      "default": "course-package/v1",
      "enum": [
        "course-package/v1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "package_id": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
      "title": "Package Id",
      "type": "string"
    },
    "course_id": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
      "title": "Course Id",
      "type": "string"
    },
    "lesson_id": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
      "title": "Lesson Id",
      "type": "string"
    },
    "content_version": {
      "default": 0,
      "minimum": 0,
      "title": "Content Version",
      "type": "integer"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "sealed"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "unit": {
      "minLength": 1,
      "title": "Unit",
      "type": "string"
    },
    "era": {
      "minLength": 1,
      "title": "Era",
      "type": "string"
    },
    "body": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Body",
      "type": "array"
    },
    "abstract": {
      "default": "",
      "title": "Abstract",
      "type": "string"
    },
    "course_title": {
      "default": "",
      "title": "Course Title",
      "type": "string"
    },
    "era_id": {
      "default": "content",
      "title": "Era Id",
      "type": "string"
    },
    "section": {
      "default": "内容包",
      "title": "Section",
      "type": "string"
    },
    "lesson_no": {
      "default": "",
      "title": "Lesson No",
      "type": "string"
    },
    "duration": {
      "default": "",
      "title": "Duration",
      "type": "string"
    },
    "teaching_objectives": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Teaching Objectives",
      "type": "array"
    },
    "keywords": {
      "items": {
        "$ref": "#/$defs/KeywordV1"
      },
      "title": "Keywords",
      "type": "array"
    },
    "people": {
      "items": {
        "$ref": "#/$defs/PersonV1"
      },
      "title": "People",
      "type": "array"
    },
    "map_points": {
      "items": {
        "$ref": "#/$defs/MapPointV1"
      },
      "title": "Map Points",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/FactV1"
      },
      "title": "Facts",
      "type": "array"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRefV1"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "qa_points": {
      "items": {
        "type": "string"
      },
      "title": "Qa Points",
      "type": "array"
    },
    "level_goals": {
      "items": {
        "type": "string"
      },
      "title": "Level Goals",
      "type": "array"
    },
    "scenario_refs": {
      "items": {
        "$ref": "#/$defs/ScenarioRefV1"
      },
      "title": "Scenario Refs",
      "type": "array"
    },
    "seed_canvas": {
      "items": {
        "$ref": "#/$defs/SeedCanvasNodeV1"
      },
      "title": "Seed Canvas",
      "type": "array"
    },
    "teacher_notes": {
      "default": "",
      "title": "Teacher Notes",
      "type": "string"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    },
    "sealed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sealed At"
    },
    "sealed_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sealed By"
    },
    "checksum": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checksum"
    },
    "compatibility": {
      "$ref": "#/$defs/CompatibilitySourceV1"
    }
  },
  "required": [
    "package_id",
    "course_id",
    "lesson_id",
    "title",
    "unit",
    "era",
    "status"
  ],
  "title": "CoursePackageV1",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "draft"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "content_version": {
            "const": 0
          },
          "sealed_at": {
            "const": null
          },
          "sealed_by": {
            "const": null
          },
          "checksum": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "sealed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "body",
          "content_version",
          "sealed_at",
          "sealed_by",
          "checksum"
        ],
        "properties": {
          "body": {
            "minItems": 1
          },
          "content_version": {
            "minimum": 1
          },
          "sealed_at": {
            "type": "string"
          },
          "sealed_by": {
            "type": "string",
            "minLength": 1
          },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
