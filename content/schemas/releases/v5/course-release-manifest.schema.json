{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronovita.local/schemas/releases/v5/course-release-manifest.schema.json",
  "$comment": "V5 requires exact V2 evidence and one immutable PersonaPackV1 per lesson, while retaining all course, scenario and presentation bindings.",
  "$defs": {
    "CourseReleaseItemV5": {
      "additionalProperties": false,
      "description": "V4 lesson resources plus one exact, reviewed persona-expression pack.",
      "properties": {
        "lesson_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Lesson Id",
          "type": "string"
        },
        "course_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Course Id",
          "type": "string"
        },
        "content_version": {
          "minimum": 1,
          "title": "Content Version",
          "type": "integer"
        },
        "source_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Checksum",
          "type": "string"
        },
        "course_package": {
          "$ref": "#/$defs/RuntimeArtifactDescriptorV1"
        },
        "scenarios": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuntimeArtifactDescriptorV1"
          },
          "title": "Scenarios",
          "type": "array"
        },
        "primary_scenario_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 2,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Scenario Id"
        },
        "evidence_corpus": {
          "$ref": "#/$defs/EvidenceSupplementDescriptorV2"
        },
        "lesson_presentation": {
          "$ref": "#/$defs/ReleaseSupplementDescriptorV1"
        },
        "persona_pack": {
          "$ref": "#/$defs/PersonaSupplementDescriptorV1"
        },
        "audience": {
          "const": "published",
          "default": "published",
          "enum": [
            "published"
          ],
          "title": "Audience",
          "type": "string"
        }
      },
      "required": [
        "lesson_id",
        "course_id",
        "content_version",
        "source_path",
        "source_checksum",
        "course_package",
        "evidence_corpus",
        "lesson_presentation",
        "persona_pack"
      ],
      "title": "CourseReleaseItemV5",
      "type": "object"
    },
    "EvidenceSupplementDescriptorV2": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "evidence-corpus",
          "default": "evidence-corpus",
          "enum": [
            "evidence-corpus"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "evidence-corpus/v2",
          "default": "evidence-corpus/v2",
          "enum": [
            "evidence-corpus/v2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "course_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Course Id",
          "type": "string"
        },
        "lesson_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Lesson Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "course_id",
        "lesson_id",
        "version",
        "checksum",
        "path"
      ],
      "title": "EvidenceSupplementDescriptorV2",
      "type": "object"
    },
    "PersonaSupplementDescriptorV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "persona-pack",
          "default": "persona-pack",
          "enum": [
            "persona-pack"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "persona-pack/v1",
          "default": "persona-pack/v1",
          "enum": [
            "persona-pack/v1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "course_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Course Id",
          "type": "string"
        },
        "lesson_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Lesson Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "course_id",
        "lesson_id",
        "version",
        "checksum",
        "path"
      ],
      "title": "PersonaSupplementDescriptorV1",
      "type": "object"
    },
    "ReleaseSupplementDescriptorV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "evidence-corpus",
            "lesson-presentation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "evidence-corpus/v1",
            "lesson-presentation/v1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "course_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Course Id",
          "type": "string"
        },
        "lesson_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Lesson Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "artifact_id",
        "course_id",
        "lesson_id",
        "version",
        "checksum",
        "path"
      ],
      "title": "ReleaseSupplementDescriptorV1",
      "type": "object"
    },
    "RuntimeArtifactDescriptorV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "course-package",
            "scenario-template"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "course-package/v1",
            "scenario-template/v1"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "course_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Course Id",
          "type": "string"
        },
        "lesson_id": {
          "maxLength": 64,
          "minLength": 2,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
          "title": "Lesson Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "checksum": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "artifact_id",
        "course_id",
        "lesson_id",
        "version",
        "checksum",
        "path"
      ],
      "title": "RuntimeArtifactDescriptorV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "course-release/v5",
      "default": "course-release/v5",
      "enum": [
        "course-release/v5"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "release_id": {
      "minLength": 1,
      "title": "Release Id",
      "type": "string"
    },
    "release_no": {
      "minimum": 1,
      "title": "Release No",
      "type": "integer"
    },
    "course_id": {
      "maxLength": 64,
      "minLength": 2,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$",
      "title": "Course Id",
      "type": "string"
    },
    "operation": {
      "enum": [
        "bootstrap",
        "publish",
        "rollback"
      ],
      "title": "Operation",
      "type": "string"
    },
    "parent_release_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Release Id"
    },
    "restored_from_release_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Restored From Release Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "minLength": 1,
      "title": "Created By",
      "type": "string"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    },
    "items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CourseReleaseItemV5"
      },
      "title": "Items",
      "type": "array"
    },
    "checksum": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Checksum",
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "release_no",
    "course_id",
    "operation",
    "created_at",
    "created_by",
    "checksum"
  ],
  "title": "CourseReleaseManifestV5",
  "type": "object"
}
